{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "perf@latest",
    "rabbitmq-server@latest",
    "activemq@latest",
    "rust-code-analysis@latest",
    "actionlint@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "cargo test"
      ],
      "bench": [
        "cargo bench"
      ],
      "loadtest": [
        "cargo run --release --example loadtest -- $@"
      ],
      "fmt": [
        "cargo fmt --check"
      ],
      "lint": [
        "cargo clippy --all-targets -- -D warnings -W clippy::pedantic",
        "cargo clippy --all-targets --no-default-features -- -D warnings -W clippy::pedantic",
        "actionlint"
      ],
      "complexity": [
        "rust-code-analysis-cli -m -O json -p src > target/metrics.jsonl",
        "python3 scripts/complexity.py target/metrics.jsonl"
      ],
      "check": [
        "cargo fmt --check",
        "cargo clippy --all-targets -- -D warnings -W clippy::pedantic",
        "cargo clippy --all-targets --no-default-features -- -D warnings -W clippy::pedantic",
        "actionlint",
        "rust-code-analysis-cli -m -O json -p src > target/metrics.jsonl",
        "python3 scripts/complexity.py target/metrics.jsonl",
        "cargo test"
      ]
    }
  }
}
